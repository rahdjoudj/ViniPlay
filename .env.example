# ViniPlay Environment Variables
# Copy this file to .env and fill in your values.

# A long, random secret string used to sign session cookies.
# Generate one: openssl rand -hex 64
SESSION_SECRET=replace_this_with_a_very_long_random_and_secret_string

# Contact email for VAPID push notifications (required by push services).
VAPID_CONTACT_EMAIL=mailto:your_email@example.com

# Server port (default: 8998)
PORT=8998

# Node environment: development | production
NODE_ENV=production

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
