{
  "name": "viniplay",
  "version": "0.12.0",
  "description": "A simple IPTV player with server-side storage and user authentication.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:frontend": "node scripts/build-frontend.js"
  },
  "author": "Andrea Ardovini",
  "license": "CC BY-NC-SA 4.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.2",
    "fuse.js": "^7.1.0",
    "helmet": "^8.0.0",
    "hls.js": "^1.6.16",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "systeminformation": "^5.27.11",
    "web-push": "^3.6.7",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.5"
  }
}
